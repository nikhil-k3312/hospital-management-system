# MediChain API configuration. Copy to backend/services/api/.env and fill in.
# Never commit the real .env file.

PORT=8001
NODE_ENV=development

# MongoDB (local: mongodb://127.0.0.1:27017/medichain)
MONGODB_URI=mongodb://127.0.0.1:27017/medichain

# JWT secrets: two DIFFERENT long random values. Generate each with: openssl rand -hex 64
JWT_SECRET=<generate-with: openssl rand -hex 64>
JWT_REFRESH_SECRET=<generate-with: openssl rand -hex 64>
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Email. EMAIL_TRANSPORT=smtp sends real mail (required in production).
# "console" prints emails (including OTP codes) to the server log: development only.
EMAIL_TRANSPORT=smtp
EMAIL_SERVICE=gmail
EMAIL_USER=<your-email@gmail.com>
EMAIL_PASSWORD=<your-gmail-app-password>
EMAIL_FROM=MediChain <your-email@gmail.com>

OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=10

# Redis (local: brew services start redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Zero-trust thresholds (0-100)
MIN_TRUST_SCORE=50
HIGH_SENSITIVITY_TRUST_SCORE=70
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=30

# Rate limits per IP per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30

MAX_UPLOAD_MB=10

# Comma-separated origins allowed to call the API cross-origin.
# The bundled frontend is served by the API itself and needs no entry here.
ALLOWED_ORIGINS=http://localhost:8001

# Demo seed (npm run seed). Demo accounts are created as plus-addresses of
# SEED_EMAIL_BASE (e.g. you+patient@gmail.com) so every OTP reaches one inbox.
SEED_EMAIL_BASE=<your-email@gmail.com>
SEED_DEMO_PASSWORD=<a strong password: 8+ chars, upper, lower, digit, symbol>

# IPFS storage for attachments (Kubo HTTP API). Files are AES-256-GCM encrypted
# before upload; only ciphertext reaches IPFS. Leave IPFS_API_URL empty to keep GridFS.
IPFS_API_URL=http://127.0.0.1:5001
IPFS_ENCRYPTION_KEY=<generate-with: openssl rand -hex 32>
IPFS_TIMEOUT_MS=15000

# Blockchain anchoring (hashes only) in the HealthRecordRegistry contract.
# Local chain: cd blockchain && npx hardhat node, then npx hardhat run scripts/deploy.js --network localhost
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_CONTRACT_ADDRESS=<printed by the deploy script>
CHAIN_PRIVATE_KEY=<this hospital's signing key>
PATIENT_REF_SECRET=<generate-with: openssl rand -hex 32>

# Second-time login: how long a browser stays trusted after a full password + OTP login.
TRUSTED_DEVICE_DAYS=30

# Dynamic login (every login after the first): trust score from location (IP vs GPS),
# device, time and network. IP locations come from the offline geoip-lite database.
# Comma-separated CIDR ranges of the hospital's own networks (score 20 when signing in from them).
HOSPITAL_NETWORKS=10.0.0.0/8,192.168.0.0/16
HOSPITAL_TIMEZONE=Asia/Kolkata
DUTY_START_HOUR=8
DUTY_END_HOUR=20

# Emergency sign-in (doctor/admin): session length in minutes
EMERGENCY_SESSION_MINUTES=30
